{
  "name": "@sift/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "indexes": "node scripts/sync-indexes.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:atlas": "vitest run --config vitest.atlas.config.js",
    "eval:search": "node scripts/search-eval.js",
    "eval:embeddings": "node scripts/embedding-eval.js",
    "smtp:check": "node scripts/smtp-check.js",
    "sync": "node scripts/imap-sync.js",
    "ai:check": "node scripts/ai-check.js",
    "embed:backfill": "node scripts/embed-backfill.js",
    "triage:backfill": "node scripts/triage-backfill.js",
    "threads:refresh": "node scripts/refresh-threads.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.0.6",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.28",
    "mongoose": "^8.20.1",
    "nodemailer": "^10.0.10",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
