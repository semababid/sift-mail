# Local Mongo for stages 1-4. Swap to the Atlas connection string at stage 5,
# since vector search is not available in the community container.
MONGO_URI=mongodb://localhost:27017/sift
MONGO_URI_ATLAS=

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ollama | openai | anthropic
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2

# Stage 4, whichever inbound route you pick
MAILGUN_SIGNING_KEY=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
