# Local Mongo for stages 1-4. From stage 5 on, the Atlas connection string
# goes here, since vector search does not run in the local container. Atlas
# needs the database name in the string: ...mongodb.net/sift?retryWrites=true
# After switching, npm run indexes --workspace=server builds the indexes there,
# the vector index included.
MONGO_URI=mongodb://localhost:27017/sift
# The Atlas string again, for npm run test:atlas --workspace=server. Those
# tests use a database of their own on the cluster, sift_atlas_test, and empty
# it when they finish.
MONGO_URI_ATLAS=

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

PORT=4000
# development | test | production. Production turns off pretty logs and
# autoIndex, and switches cookies to SameSite=None; Secure.
NODE_ENV=development
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173

# The model service, stage 5 on. "ollama" runs models on this machine;
# "hosted" is a placeholder until stage 10.3. EMBEDDING_MODEL has to make
# vectors of the size EMBEDDING_DIMS names in server/src/lib/constants.js
# (1024 for bge-m3, which handles German and English mail alike; compare
# others with npm run eval:embeddings). A chat model of 3B to 9B parameters
# is comfortable on 16 GB of memory; qwen3.5:9b answers better, llama3.2 faster.
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3
CHAT_MODEL=qwen3.5:9b

# Stage 4, whichever inbound route you pick
MAILGUN_SIGNING_KEY=

# Inbound mail over IMAP, stage 4.5. npm run dev starts the sync worker, which
# does nothing while IMAP_HOST is empty. IMAP_OWNER is the Sift account the
# mail is filed under. For the Gmail account used for SMTP: imap.gmail.com,
# port 993, the same address and app password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_OWNER=

# Attachments, stage 4.3. Files are kept on disk under ATTACHMENT_DIR, which
# defaults to data/attachments in the repo (ignored by git). A message being
# sent may carry ATTACHMENT_MAX_MB of files in all, and an imported file over
# it is listed but not stored. Sending through Gmail, use 18: Gmail measures
# its 25 MB limit after encoding, which makes files about a third larger.
ATTACHMENT_DIR=
ATTACHMENT_MAX_MB=25
# Outbound mail, stage 4.1. Leave SMTP_HOST empty and mail to addresses
# outside Sift is stored but not sent, which is fine against seeded contacts.
# For a Gmail account with 2FA and an app password: smtp.gmail.com, port 465,
# the address as user, the app password, and the same address as SMTP_FROM.
# Everything goes out from SMTP_FROM with the sending user's name on it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
